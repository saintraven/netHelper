{
  "name": "netHelper · Telegram long polling",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "limit": 50,
        "timeout": 60,
        "restrictChatIds": "",
        "restrictUserIds": ""
      },
      "id": "a1000001-0001-4001-8001-000000000001",
      "name": "Telegram long polling",
      "type": "@mentoster/n8n-nodes-telegram-polling.telegramPollingTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "const u = $input.first().json;\nconst msg = u.message || u.edited_message || {};\nconst text = (msg.text || '').trim();\nconst chatId = msg.chat?.id;\nconst from = msg.from?.username || msg.from?.first_name || 'user';\nreturn [{\n  json: {\n    chatId,\n    text,\n    from,\n    command: text.split(/\\s+/)[0]?.toLowerCase() || '',\n    raw: u,\n  },\n}];\n"
      },
      "id": "a1000001-0001-4001-8001-000000000002",
      "name": "Parse message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "/check",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "check"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "strict" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "/start",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "start"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "a1000001-0001-4001-8001-000000000003",
      "name": "Route command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.PROMETHEUS_URL || 'http://localhost:9090').replace(/\\/$/, '') + '/api/v1/query' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ \"probe_success{target_id=\\\"\" + ($env.TARGET_ID || 'edge-router-01') + \"\\\"}\" }}"
            }
          ]
        }
      },
      "id": "a1000001-0001-4001-8001-000000000004",
      "name": "Query Prometheus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 180]
    },
    {
      "parameters": {
        "jsCode": "const targetId = $env.TARGET_ID || 'edge-router-01';\nconst prom = $input.first().json;\nconst ok = prom?.status === 'success';\nconst rows = ok ? prom.data?.result || [] : [];\nconst row = rows.find((r) => r.metric?.target_id === targetId) || rows[0];\nconst v = row?.value?.[1];\nconst probe = v === undefined ? null : Number(v);\nlet status = 'unknown';\nif (!ok) status = 'prometheus_error';\nelse if (probe === 1) status = 'up';\nelse if (probe === 0) status = 'down';\nelse status = 'no_data';\nconst chatId = $('Parse message').first().json.chatId;\nconst lines = [\n  `Target: ${targetId}`,\n  `probe_success: ${probe === null ? 'n/a' : probe}`,\n  `Status: ${status}`,\n];\nreturn [{ json: { chatId, text: lines.join('\\n') } }];\n"
      },
      "id": "a1000001-0001-4001-8001-000000000005",
      "name": "Format check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 180]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "a1000001-0001-4001-8001-000000000006",
      "name": "Reply check",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "netHelper bot (long polling, no webhook).\\n/check — probe_success\\n/ping — pong",
        "additionalFields": {}
      },
      "id": "a1000001-0001-4001-8001-000000000007",
      "name": "Reply start",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [820, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "Unknown command. Try /check or /start",
        "additionalFields": {}
      },
      "id": "a1000001-0001-4001-8001-000000000008",
      "name": "Reply other",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [820, 440]
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram long polling": {
      "main": [[{ "node": "Parse message", "type": "main", "index": 0 }]]
    },
    "Parse message": {
      "main": [[{ "node": "Route command", "type": "main", "index": 0 }]]
    },
    "Route command": {
      "main": [
        [{ "node": "Query Prometheus", "type": "main", "index": 0 }],
        [{ "node": "Reply start", "type": "main", "index": 0 }],
        [{ "node": "Reply other", "type": "main", "index": 0 }]
      ]
    },
    "Query Prometheus": {
      "main": [[{ "node": "Format check", "type": "main", "index": 0 }]]
    },
    "Format check": {
      "main": [[{ "node": "Reply check", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "netHelper" }, { "name": "telegram-polling" }]
}