# n8n (локально / oleg_vm / compose)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

# URL Prometheus с точки зрения n8n (в docker-сети: http://prometheus:9090)
PROMETHEUS_URL=http://localhost:9090

# Хакатон: тестовая цель (kebab-case)
TARGET_ID=edge-router-01

# DeepSeek API (модель deepseek-flash, OpenAI-совместимый endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Уведомления (приоритет — почта)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=